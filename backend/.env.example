# Kiku Backend Configuration
KIKU_APP_NAME=Kiku API
# Production: set to your deployed frontend origin, e.g. https://app.example.com.
KIKU_FRONTEND_ORIGIN=http://localhost:5173
# KIKU_COOKIE_SECURE is auto-enabled for HTTPS frontend origins; set KIKU_COOKIE_SECURE=true if TLS terminates before the app sees the HTTPS origin.

# LLM / AI Layer API Configuration (Opencode / OpenAI)
OPENCODE_API_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_API_KEY=
OPENCODE_LLM_MODEL=deepseek-v4-flash-free

# Embeddings Configuration (OpenAI text-embedding-3-small)
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase Configuration (publishable/anon key; database access is enforced by RLS)
SUPABASE_URL=
SUPABASE_KEY=
# Backend-only key for chat persistence. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Production Environment Configuration
# Production deploys must set KIKU_ENV=production.
KIKU_ENV=development
# KIKU_ENABLE_OPENAPI=false disables /docs, /redoc, and /openapi.json in
# production only; development and other non-production environments keep them enabled.
KIKU_ENABLE_OPENAPI=false
